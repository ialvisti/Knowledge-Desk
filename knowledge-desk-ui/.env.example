# Destino del backend RAG para el proxy de desarrollo de Vite.
KNOWLEDGE_API_TARGET=http://127.0.0.1:8000

# Alternativa: llamar a la API directamente desde el navegador, sin proxy.
# Requiere que el backend permita el origen del navegador por CORS.
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Espera máxima por respuesta, en milisegundos (por defecto 120000).
# VITE_API_TIMEOUT_MS=120000
