# Configuración del servidor de Knowledge Desk. Copia este archivo a .env (ignorado
# por git) y completa SOLO en tu equipo o en el panel del proveedor de despliegue.
# Ningún valor de este archivo llega al navegador.

# --- Servidor -----------------------------------------------------------------
# Por defecto escucha solo en 127.0.0.1:8787. En Render: KD_HOST=0.0.0.0 y el
# puerto llega en PORT.
KD_HOST=127.0.0.1
KD_PORT=8787
# Registro documental, JSON originales, fragmentos e índice local. En la vista
# previa gratuita de Render es efímero (/tmp/knowledge-desk, con
# KD_DATOS_TEMPORALES=true). Con un plan con disco, una ruta dentro del disco.
KD_DATA_DIR=
# Interfaz compilada que sirve el propio servidor (por defecto ../knowledge-desk-ui/dist).
KD_UI_DIST=
# true solo si KD_DATA_DIR es efímero (p. ej. la vista previa gratuita de Render,
# sin disco): la interfaz avisa que los artículos cargados se pierden al reiniciar
# o redesplegar. No cambia el modo ni los servicios usados.
KD_DATOS_TEMPORALES=

# --- Artículos de conocimiento ------------------------------------------------
# Solo se admiten artículos JSON kb_article_v2. Tamaño máximo en MB (1–200; por defecto 50).
KD_MAX_ARTICULO_MB=50
# Espera máxima a que el índice confirme una versión antes de publicarla (ms).
KD_VERIFICACION_INDICE_MS=60000

# --- Corpus -------------------------------------------------------------------
# forusguide | local. Sin valor, el servidor informa que no está configurado.
KD_MODO=

# Modo forusguide: consulta en el endpoint knowledge-question de ForUsGuide y
# documentos en el MISMO índice Pinecone que lee ese backend.
FORUSGUIDE_API_URL=
FORUSGUIDE_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
# Debe coincidir con el NAMESPACE que lee ForUsGuide (su valor por defecto es kb_articles).
PINECONE_NAMESPACE=

# Modo local: cualquier servicio con API compatible con OpenAI (Ollama, LM Studio,
# vLLM, OpenAI…). Ejemplo Ollama: KD_LLM_BASE_URL=http://127.0.0.1:11434/v1
KD_LLM_BASE_URL=
KD_LLM_API_KEY=
KD_EMBEDDINGS_MODEL=
KD_CHAT_MODEL=
# Opcional. "none" envía reasoning_effort=none en el chat: lo necesitan los modelos
# de razonamiento que solo aceptan temperature 0 así (p. ej. gpt-6-luna). Vacío: el
# cuerpo del chat no cambia. Cualquier otro valor se rechaza al arrancar.
KD_CHAT_REASONING_EFFORT=

# --- Consulta -----------------------------------------------------------------
# Tiempo máximo de una consulta. Rango aceptado 30000–120000 ms; por defecto 90000.
KD_CONSULTA_TIMEOUT_MS=90000
# Política kd-cobertura-v1: afinidad mínima de un fragmento relevante y umbrales.
KD_COBERTURA_MIN=0.2
KD_COBERTURA_ALTA=0.35
KD_COBERTURA_MEDIA=0.22
# Canal del área responsable para "Contactar al área" (mailto: o https://).
KD_CONTACTO_URL=
# Preguntas de ejemplo por modo de corpus (por defecto config/ejemplos.json).
KD_EJEMPLOS_ARCHIVO=

# --- Acceso interno -----------------------------------------------------------
# Fuera de localhost hace falta a), b) o c).
#  c) KD_ACCESO_PUBLICO=true: acceso directo sin inicio de sesión, solo para una
#     vista previa pública decidida de forma explícita. Cualquiera con la URL
#     consulta y administra artículos; las operaciones se registran como
#     "Acceso público". No se combina con KD_ACCESO_BASICO, KD_IDENTIDAD_HEADER,
#     KD_PROXY_SECRETO ni KD_OPERADORES (el servidor no arranca) e ignora
#     KD_OPERADOR. Con KD_MODO=forusguide es solo de consulta: tampoco admite
#     PINECONE_API_KEY ni PINECONE_INDEX_HOST, para no escribir en el índice
#     compartido. Por defecto false.
KD_ACCESO_PUBLICO=
# Para el acceso controlado, una de estas dos opciones:
#  a) Credenciales de piloto (HTTP Basic sobre HTTPS): usuario:clave[,usuario:clave]
#     Claves de 12 caracteres o más.
KD_ACCESO_BASICO=
#  b) Proxy de identidad corporativo que añade la cabecera de identidad Y el
#     secreto compartido x-kd-proxy-secreto. Sin el secreto, la cabecera se ignora.
KD_IDENTIDAD_HEADER=
KD_PROXY_SECRETO=
# Quiénes pueden cargar, reemplazar y eliminar documentos (lista separada por comas).
# Vacío: cualquier usuario con acceso.
KD_OPERADORES=
# Nombre del operador cuando no hay identidad (solo uso local).
KD_OPERADOR=operador.tecnico

# --- Solo demostración ----------------------------------------------------------
# KD_DEMO_SIMULADO=true lo fija únicamente el stack simulado (scripts\simulado.ps1)
# para que la interfaz avise de que las respuestas son simuladas. No lo uses con
# servicios reales.
